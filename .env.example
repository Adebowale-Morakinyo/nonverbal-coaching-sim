DATABASE_URL=postgres://user:pass@localhost:5432/nonverbal_sim
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5:nitro
LLM_REPORT_MODEL=anthropic/claude-sonnet-4.5
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_SIMULATION_MODE=false
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Candidate speech-to-text provider.
# Options:
# - webspeech: free browser Web Speech API. Works best in Chrome.
# - elevenlabs: ElevenLabs Scribe. Uses ElevenLabs credits.
VITE_STT_PROVIDER=webspeech

# Required for VITE_STT_PROVIDER=elevenlabs.
# Also used for AI text-to-speech playback in the browser.
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
